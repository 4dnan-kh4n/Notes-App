<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Notes App</title>
    <link rel="stylesheet" href="/stylesheets/styles.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Fraunces:opsz,wght@9..144,600;9..144,700&amp;display=swap"
      rel="stylesheet"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"
      type="text/javascript"
    ></script>
    <script
      src="https://cdn.tailwindcss.com/3.4.17"
      type="text/javascript"
    ></script>
    <script
      src="/_sdk/0e8d3a91e1c6f495.data_sdk.js"
      type="text/javascript"
      integrity="sha512-c00oDoGjsMgluCLLEyVl3suwEkgjOGGplVFbsilUoBg4aMKNmsL3mwsc9r0dPn95qiSZyjBousQXgROkAW7p/w=="
    ></script>
    <script
      src="/_sdk/eba18683f23e5798.resizing_sdk.js"
      type="text/javascript"
      integrity="sha512-E0UWUllhwPXaNJtjyTKXWKrIE+FruPfFpO4mRmMDP2LI+U9bOizy5npCq6xx/JyWcvSK7D3TFf2wFR2Mha9kbA=="
    ></script>
  </head>

  <body data-template-id="__page-root">
    <div class="app-wrapper">
      <header class="workspace-shell app-header">
        <div>
          <div class="identity-row">
            <span class="identity-icon" aria-hidden="true">✦</span>
            <span class="eyebrow">Personal workspace</span>
          </div>
          <p class="subtitle">
            A quiet corner for your ideas, reminders, and things worth returning
            to.
          </p>
        </div>
      </header>
      <main class="workspace-shell">
        
        <section class="collection-section" aria-labelledby="notes-heading">
          <div class="collection-heading">
            <div>
              <h2 id="notes-heading" class="display-font">Your collection</h2>
            </div>
          </div>

          <article class="note-card">
        <p class="note-copy">
            <%= files %>
        </p>

        <div class="card-actions">
            <a class="edit-button" href="/">
                Back
            </a>
        </div>
    </article>

            
        </section>
      </main>
    </div>
    <script
      src="/_sdk/d97541380e824b1a.editing_sdk.js"
      integrity="sha512-iBVkuiyctyjmaqUwrsoYSc/nxwymdEKZMKPeBCNj6uN/7hFPTiMVeunYJjJVnUh1GNECKEyCerl7IHtlqhzSYQ=="
    ></script>
  </body>
</html>
